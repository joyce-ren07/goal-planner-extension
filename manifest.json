{
  "manifest_version": 3,
  "name": "Goal Planner for Google Calendar",
  "version": "1.0",
  "description": "Plan long-term goals and block focused work sessions directly in Google Calendar.",
  "permissions": ["identity", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "406008612162-m5le40di3sfmk6ak8htdhn62qnsepmh4.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
