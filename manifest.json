{
  "manifest_version": 3,
  "name": "Goal Planner for Google Calendar",
  "version": "1.1.0",
  "description": "Plan long-term goals, block focused work sessions, and manage tasks in a kanban board — directly in Google Calendar.",
  "permissions": ["identity", "storage", "scripting", "tabs"],
  "host_permissions": ["https://calendar.google.com/*", "https://tasks.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "406008612162-m5le40di3sfmk6ak8htdhn62qnsepmh4.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  },
  "action": {
    "default_title": "Toggle My Tasks sidebar"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": [
        "goalModel.js",
        "goalCalendarSync.js",
        "content.js",
        "panelCoordinator.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tasks.google.com/*"],
      "js": ["TaskDeleteConfirm.js", "TaskDetailPopup.js", "kanbanSidebar.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html"],
      "matches": ["https://calendar.google.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
